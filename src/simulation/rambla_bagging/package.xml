<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rambla_bagging</name>
  <version>0.0.1</version>
  <description>Records an observation batch (rosbag2/MCAP) of the stable sensor topic contract, for later SLAM/mapping processing. See robot/slam/plans/real-map-plan-2026-07-06.md Phase 1.</description>
  <maintainer email="jackdemarco.jd@gmail.com">Jack Demarco</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
