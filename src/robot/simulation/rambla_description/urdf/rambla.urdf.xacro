<?xml version="1.0" ?>
<robot name="rambla" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="params.xacro" />
  <xacro:include filename="inertial.xacro" />
  <xacro:include filename="plugins.xacro" />
  <xacro:include filename="materials.xacro" />

  <!-- ****************** **************** ****************** -->

  <!-- One bumper half: a single box spanning its 90-deg arc (midpoint angle
       a0+45), tangent to the body at the body radius. Exactly one unnamed
       collision per link (sdformat auto-names it "<link>_collision") so the
       contact sensor watches one collision on its own dedicated link - the
       pattern proven working in iRobotEducation/create3_sim, replacing the
       many-named-facet-collisions-per-sensor layout this repo used to have. -->
  <xacro:macro name="bumper_half" params="name parent a0">
    <xacro:property name="ang" value="${a0 + 45}"/>
    <!-- Chord of the full 90-deg arc, padded 15% so it comfortably covers the
         arc's midpoint tangent without falling short at the edges. -->
    <xacro:property name="width" value="${2 * (base_diameter/2) * sin(0.5 * 90.0 * DEG2RAD) * 1.15}"/>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${(base_diameter/2)*cos(ang*DEG2RAD)} ${(base_diameter/2)*sin(ang*DEG2RAD)} ${bumper_z}"
              rpy="0 0 ${(ang+90)*DEG2RAD}"/>
    </joint>

    <gazebo reference="${name}_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${width} ${bumper_thickness} ${bumper_height}"/>
        </geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${width} ${bumper_thickness} ${bumper_height}"/>
        </geometry>
      </collision>
      <xacro:solid_box_inertia m="0.02" x="${width}" y="${bumper_thickness}" z="${bumper_height}"/>
    </link>
  </xacro:macro>

  <!-- base_footprint is conventionally massless/geometry-less so gz-sim can
       freely lump it into base_link. preserveFixedJoint below stops that
       lumping (needed so <gazebo reference="base_link"|...> sensors resolve
       correctly - see the comment on base_joint), which means base_footprint
       must now stand as a real link on its own; sdformat rejects a
       zero-mass root link, so it needs a negligible placeholder inertial. -->
  <link name="base_footprint">
    <xacro:solid_box_inertia m="0.001" x="0.01" y="0.01" z="0.01"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${floor_clearance}" rpy="0 0 0"/>
  </joint>

  <!-- Without this, gz-sim's URDF->SDF conversion lumps base_link's fixed
       children (visuals, collisions, sensors) into base_footprint, since
       base_footprint is the model's canonical/root link. That silently
       relocates every <gazebo reference="base_link"|"base_scan"|etc.> sensor
       onto base_footprint and mangles named collisions (breaking the bumper
       contact sensor's <contact><collision> references) - see
       https://github.com/gazebosim/sdformat/issues/378. -->
  <gazebo reference="base_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${lower_cylinder_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${lower_cylinder_height}" radius="${base_diameter/2}"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${lower_cylinder_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${lower_cylinder_height}" radius="${base_diameter/2}"/>
      </geometry>
    </collision>

    <xacro:solid_cylinder_inertia m="${lower_cylinder_mass}" r="${base_diameter/2}" h="${lower_cylinder_height}"/>
  </link>

  <!-- Front bumper = front 180 deg of the body, as two dedicated links (each
       with its own fixed joint + single collision). Left half 0..+90 deg,
       right half -90..0 deg (meet at the front, 0 deg, no dead-center gap). -->
  <xacro:bumper_half name="bumper_left" parent="base_link" a0="0"/>
  <xacro:bumper_half name="bumper_right" parent="base_link" a0="-90"/>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_inset-base_diameter/2} 0 ${caster_diameter/2-floor_clearance}" rpy="0 0 0"/>
  </joint>

  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_diameter/2}"/>
      </geometry>
      <material name="grey"/>
    </visual>

   <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_diameter/2}"/>
      </geometry>
    </collision>

    <xacro:solid_sphere_inertia m="${caster_mass}" r="${caster_diameter/2}"/>
  </link>


  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 ${wheel_base/2} ${wheel_diameter/2-floor_clearance}" rpy="-${pi/2} 0 0"/>
    <axis xyz="0 0 1">
      <limit>
        <effort>${motor_stall_torque}</effort>
      </limit>
    </axis>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_diameter/2}"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_diameter/2}"/>
      </geometry>
    </collision>

    <xacro:solid_cylinder_inertia m="${wheel_mass}" r="${wheel_diameter/2}" h="${wheel_width}"/>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 ${-wheel_base/2} ${wheel_diameter/2-floor_clearance}" rpy="-${pi/2} 0 0"/>
    <axis xyz="0 0 1">
      <limit>
        <effort>${motor_stall_torque}</effort>
      </limit>
    </axis>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_diameter/2}"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${wheel_width}" radius="${wheel_diameter/2}"/>
      </geometry>
    </collision>

    <xacro:solid_cylinder_inertia m="${wheel_mass}" r="${wheel_diameter/2}" h="${wheel_width}"/>
  </link>


  <!-- Upright top-mounted LiDAR turret (+Z up, CCW scan). -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="${lidar_center_offset} 0 ${lower_cylinder_height + laser_puck_offset}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="scan_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${laser_puck_height}" radius="${laser_puck_diameter/2}"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="${laser_puck_height}" radius="${laser_puck_diameter/2}"/>
      </geometry>
    </collision>

    <xacro:solid_cylinder_inertia m="${laser_puck_mass}" r="${laser_puck_diameter/2}" h="${laser_puck_height}"/>
  </link>

  <!-- Forward-facing camera, mounted on the front edge of the body, above the
       front bumper band so the bumper doesn't occlude its field of view
       (see camera_z comment in params.xacro). -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${base_diameter/2 - camera_depth/2} 0 ${camera_z}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_depth} ${camera_width} ${camera_height}"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_depth} ${camera_width} ${camera_height}"/>
      </geometry>
    </collision>

    <xacro:solid_box_inertia m="${camera_mass}" x="${camera_depth}" y="${camera_width}" z="${camera_height}"/>
  </link>

  <!-- Optical frame child, rotated to the REP-103/104 camera-optical convention
       (Z forward, X right, Y down) so sensor_msgs/Image data lines up with the
       usual ROS image-processing/RViz expectations. -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <gazebo reference="camera_optical_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <link name="camera_link_optical">
    <xacro:solid_box_inertia m="0.001" x="0.01" y="0.01" z="0.01"/>
  </link>

  <!-- IMU, placeholder chip at the geometric center of base_link. -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${lower_cylinder_height/2}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size}"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size}"/>
      </geometry>
    </collision>

    <xacro:solid_box_inertia m="${imu_mass}" x="${imu_size}" y="${imu_size}" z="${imu_size}"/>
  </link>

</robot>
