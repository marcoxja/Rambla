<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rambla_sim</name>
  <version>0.0.1</version>
  <description>Apartment-scale Gazebo world spawning the Rambla robot description with full sensor/control bridging.</description>
  <maintainer email="jackdemarco.jd@gmail.com">Jack Demarco</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rambla_description</exec_depend>
  <exec_depend>rambla_localization</exec_depend>
  <exec_depend>rambla_safety</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>tf2_ros</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>nav_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
