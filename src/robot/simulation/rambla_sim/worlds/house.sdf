<?xml version="1.0" ?>
<!--
  house.world — Residential floor plan for indoor navigation.
  All primitives: loads instantly, no external model downloads required.

  Floor plan (16 m × 12 m, centred at origin):
  ┌──────────────────────────────────┐
  │  Living room   │  Kitchen/Dining │
  │  (west, large) │  (NE)           │
  │                ├─────────────────│
  │    Hallway     │  Bedroom 1 (SE) │
  ├────────────────┤                 │
  │  Bedroom 2(SW) │  Bathroom (E)   │
  └──────────────────────────────────┘

  Coordinates (interior face of outer walls):
    x: -7.9 to +7.9,   y: -5.9 to +5.9

  Room approximate bounds:
    Living room  : x=-7.9 to +0, y=-0.5 to +5.9
    Kitchen      : x=+0   to +7.9, y=+1.5 to +5.9
    Hallway      : x=-7.9 to +7.9, y=-0.5 to +1.5  (connects all rooms)
    Bedroom 1    : x=+2   to +7.9, y=-5.9 to -0.5
    Bedroom 2    : x=-7.9 to -1, y=-5.9 to -0.5
    Bathroom     : x=-1   to +2, y=-5.9 to -0.5

  Robot spawn area:  living room, x=-6 to -2, y=1.5 to 4.5

  Provenance / adaptation notes (Rambla M1, SIM-003):
    Adopted as a baseline from the open-source, Apache-2.0-licensed
    darshmenon/rosnav project (github.com/darshmenon/rosnav), file
    src/diff_drive_robot-main/worlds/house.world, pinned at commit
    3735fc3daf05a50d0ec0db54b781622b1322bebf. Rooms, furniture, lights,
    and materials are unchanged from upstream. Adapted for Rambla's
    Gazebo Harmonic / ROS 2 Jazzy workflow:
      - <sdf version> bumped 1.8 -> 1.9 to match Rambla's other worlds.
      - World system plugins ported from Ignition-era names
        (ignition-gazebo-*-system / ignition::gazebo::systems::*) to
        native Harmonic names (gz-sim-*-system / gz::sim::systems::*).
      - Added gz-sim-imu-system (absent upstream): Rambla's IMU sensor
        (rambla_description/urdf/plugins.xacro) has no per-model IMU
        system of its own and depends on the world declaring one, or
        /imu/data publishes nothing. See apartment_world.sdf for the
        matching plugin set on Rambla's original hand-authored world.
      - World name kept as 'house' - Rambla's launch/bridge treat the
        world launch-arg value, the file's stem, and this <world name>
        as one invariant (see apartment_world.launch.py).
    Fidelity pass (M1, SIM-003, 2026-07-09): furniture originally
    ported as single solid boxes now has legs/under-clearance (sofa,
    coffee_table, bed_1, bed_2, ns_1), stacked-box silhouettes
    (tv_stand, wardrobe, toilet, bathtub, counter_n/island toe-kicks),
    and 3 visual-only rugs, per RAMBLA_APARTMENT_WORLD_ENHANCEMENT.md's
    "Low-Compute-Cost Enhancement Review" — still primitive-geometry,
    static-body, flat-material only, no meshes/textures introduced.
    Each item's footprint/top-height was kept close to its original
    single-box numbers so room layout, doorway clearances, and the
    verified spawn point (-4, 3) remain valid.

  Launch (Rambla):
    ros2 launch rambla_sim apartment_world.launch.py world:=house
-->
<sdf version='1.9'>
  <world name='house'>

    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>

    <light name='sun' type='directional'>
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.3 0.1 -0.9</direction>
      <diffuse>1.0 0.97 0.90 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>
    <light name='ceiling_living' type='point'>
      <pose>-4 3 3 0 0 0</pose>
      <diffuse>0.9 0.85 0.75 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>12</range><linear>0.08</linear></attenuation>
    </light>
    <light name='ceiling_kitchen' type='point'>
      <pose>4 4 3 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>10</range><linear>0.1</linear></attenuation>
    </light>
    <light name='ceiling_hall' type='point'>
      <pose>0 0.5 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>12</range><linear>0.1</linear></attenuation>
    </light>

    <!-- ── Ground / floor ───────────────────────────────────────────────── -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='c'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name='v'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.88 0.82 0.72 1</ambient><diffuse>0.88 0.82 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Room floor pads (h=0.004, coloured per room) ─────────────────── -->
    <!-- Living room: warm cream -->
    <model name='floor_living'>
      <static>true</static><pose>-4 2.7 0.003 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>7.8 11 0.004</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>7.8 11 0.004</size></box></geometry>
          <material><ambient>0.95 0.90 0.78 0.8</ambient><diffuse>0.95 0.90 0.78 0.8</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Kitchen: light tile -->
    <model name='floor_kitchen'>
      <static>true</static><pose>4 3.7 0.003 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>7.8 4.4 0.004</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>7.8 4.4 0.004</size></box></geometry>
          <material><ambient>0.92 0.92 0.88 0.8</ambient><diffuse>0.92 0.92 0.88 0.8</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Bedroom 1: blue-grey carpet -->
    <model name='floor_bed1'>
      <static>true</static><pose>5 -3.2 0.003 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>5.8 5.2 0.004</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>5.8 5.2 0.004</size></box></geometry>
          <material><ambient>0.72 0.78 0.88 0.8</ambient><diffuse>0.72 0.78 0.88 0.8</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Bedroom 2: green carpet -->
    <model name='floor_bed2'>
      <static>true</static><pose>-4.5 -3.2 0.003 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>6.8 5.2 0.004</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>6.8 5.2 0.004</size></box></geometry>
          <material><ambient>0.75 0.88 0.78 0.8</ambient><diffuse>0.75 0.88 0.78 0.8</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Bathroom: grey tile -->
    <model name='floor_bath'>
      <static>true</static><pose>0.5 -3.2 0.003 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>3 5.2 0.004</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>3 5.2 0.004</size></box></geometry>
          <material><ambient>0.78 0.78 0.78 0.8</ambient><diffuse>0.78 0.78 0.78 0.8</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Outer walls (16 m × 12 m, 2.5 m tall, h=0.2 m thick) ─────────── -->
    <!-- North wall -->
    <model name='wall_n'><static>true</static><pose>0  6 1.25 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>16.4 0.2 2.5</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>16.4 0.2 2.5</size></box></geometry>
        <material><ambient>0.88 0.82 0.76 1</ambient><diffuse>0.88 0.82 0.76 1</diffuse></material>
      </visual></link></model>
    <!-- South wall -->
    <model name='wall_s'><static>true</static><pose>0 -6 1.25 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>16.4 0.2 2.5</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>16.4 0.2 2.5</size></box></geometry>
        <material><ambient>0.88 0.82 0.76 1</ambient><diffuse>0.88 0.82 0.76 1</diffuse></material>
      </visual></link></model>
    <!-- East wall -->
    <model name='wall_e'><static>true</static><pose>8  0 1.25 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>0.2 12 2.5</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.2 12 2.5</size></box></geometry>
        <material><ambient>0.88 0.82 0.76 1</ambient><diffuse>0.88 0.82 0.76 1</diffuse></material>
      </visual></link></model>
    <!-- West wall -->
    <model name='wall_w'><static>true</static><pose>-8  0 1.25 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>0.2 12 2.5</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.2 12 2.5</size></box></geometry>
        <material><ambient>0.88 0.82 0.76 1</ambient><diffuse>0.88 0.82 0.76 1</diffuse></material>
      </visual></link></model>

    <!-- ── Interior walls ────────────────────────────────────────────────── -->
    <!--
      Wall layout (thickness 0.15 m, height 2.4 m):

      HALLWAY: y=0 to 1.5 (1.5m wide, full x width)

      Interior wall A — hallway south (y=0):
        x=-8 to -3: solid (bedroom2 north)
        gap x=-3 to -1.5: door to bedroom2
        x=-1.5 to +0: solid (bathroom north)
        gap x=0 to +1.5: door to bathroom
        x=+1.5 to +4: solid (bedroom1 north)
        gap x=+4 to +5.5: door to bedroom1 from hall (fidelity-pass fix:
          bedroom1 had no entrance at all pre-fix — wall_A4 previously ran
          solid the full x=2..8 span with zero doors, confirmed both by
          this stale comment and the actual wall_A4 geometry)
        x=+5.5 to +8: solid (bedroom1 north)

      Interior wall B — hallway north / living-kitchen divide (y=1.5):
        x=-8 to -5: solid (living room south)
        gap x=-5 to -3.5: door to living room from hall
        x=-3.5 to 0: solid (living room south)
        x=0 to +5: solid (kitchen south)
        gap x=+5 to +6.5: door to kitchen from hall
        x=+6.5 to +8: solid (kitchen south)

      Interior wall C — living/kitchen N-S (x=0):
        y=1.5 to 6: solid (no door between living and kitchen)
    -->

    <!-- Wall A — south side of hallway (y=0), bedroom/bathroom north walls -->
    <!-- Segment A1: x=-8 to -3 (bedroom2 north) -->
    <model name='wall_A1'><static>true</static><pose>-5.5 0 1.2 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>5 0.15 2.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>5 0.15 2.4</size></box></geometry>
        <material><ambient>0.85 0.78 0.70 1</ambient><diffuse>0.85 0.78 0.70 1</diffuse></material>
      </visual></link></model>
    <!-- Gap A: x=-3 to -1.5 (door to bedroom2) -->
    <!-- Segment A2: x=-1.5 to +0.5 (bathroom north) -->
    <model name='wall_A2'><static>true</static><pose>-0.5 0 1.2 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>2 0.15 2.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>2 0.15 2.4</size></box></geometry>
        <material><ambient>0.85 0.78 0.70 1</ambient><diffuse>0.85 0.78 0.70 1</diffuse></material>
      </visual></link></model>
    <!-- Gap A3: x=0.5 to +2 (door to bathroom) -->
    <!-- Segment A4a: x=+2 to +4 (bedroom1 north, west of new door) -->
    <model name='wall_A4a'><static>true</static><pose>3 0 1.2 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>2 0.15 2.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>2 0.15 2.4</size></box></geometry>
        <material><ambient>0.85 0.78 0.70 1</ambient><diffuse>0.85 0.78 0.70 1</diffuse></material>
      </visual></link></model>
    <!-- Gap A4: x=+4 to +5.5 (door to bedroom1 from hall — fidelity-pass fix, see wall-layout comment above) -->
    <!-- Segment A4b: x=+5.5 to +8 (bedroom1 north, east of new door) -->
    <model name='wall_A4b'><static>true</static><pose>6.75 0 1.2 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>2.5 0.15 2.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>2.5 0.15 2.4</size></box></geometry>
        <material><ambient>0.85 0.78 0.70 1</ambient><diffuse>0.85 0.78 0.70 1</diffuse></material>
      </visual></link></model>

    <!-- Wall B — north side of hallway (y=1.5), living room / kitchen south walls -->
    <!-- Segment B1: x=-8 to -5.5 (living room south, west) -->
    <model name='wall_B1'><static>true</static><pose>-6.75 1.5 1.2 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>2.5 0.15 2.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>2.5 0.15 2.4</size></box></geometry>
        <material><ambient>0.85 0.78 0.70 1</ambient><diffuse>0.85 0.78 0.70 1</diffuse></material>
      </visual></link></model>
    <!-- Gap B: x=-5.5 to -4 (door to living room) -->
    <!-- Segment B2: x=-4 to 0 (living room south, east) -->
    <model name='wall_B2'><static>true</static><pose>-2 1.5 1.2 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>4 0.15 2.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>4 0.15 2.4</size></box></geometry>
        <material><ambient>0.85 0.78 0.70 1</ambient><diffuse>0.85 0.78 0.70 1</diffuse></material>
      </visual></link></model>
    <!-- Segment B3: x=0 to +5 (kitchen south, west) -->
    <model name='wall_B3'><static>true</static><pose>2.5 1.5 1.2 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>5 0.15 2.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>5 0.15 2.4</size></box></geometry>
        <material><ambient>0.85 0.78 0.70 1</ambient><diffuse>0.85 0.78 0.70 1</diffuse></material>
      </visual></link></model>
    <!-- Gap B4: x=+5 to +6.5 (door to kitchen) -->
    <!-- Segment B5: x=+6.5 to +8 (kitchen south, east) -->
    <model name='wall_B5'><static>true</static><pose>7.25 1.5 1.2 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>1.5 0.15 2.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>1.5 0.15 2.4</size></box></geometry>
        <material><ambient>0.85 0.78 0.70 1</ambient><diffuse>0.85 0.78 0.70 1</diffuse></material>
      </visual></link></model>

    <!-- Wall C — living/kitchen N-S divider (x=0, y=1.5 to 6) -->
    <model name='wall_C'><static>true</static><pose>0 3.75 1.2 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>0.15 4.5 2.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.15 4.5 2.4</size></box></geometry>
        <material><ambient>0.85 0.78 0.70 1</ambient><diffuse>0.85 0.78 0.70 1</diffuse></material>
      </visual></link></model>

    <!-- Wall D — bedroom2 / bathroom divider (x=-1, y=-6 to 0) -->
    <model name='wall_D'><static>true</static><pose>-1 -3 1.2 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>0.15 6 2.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.15 6 2.4</size></box></geometry>
        <material><ambient>0.85 0.78 0.70 1</ambient><diffuse>0.85 0.78 0.70 1</diffuse></material>
      </visual></link></model>

    <!-- Wall E — bathroom / bedroom1 divider (x=+2, y=-6 to 0) -->
    <model name='wall_E'><static>true</static><pose>2 -3 1.2 0 0 0</pose><link name='link'>
      <collision name='c'><geometry><box><size>0.15 6 2.4</size></box></geometry></collision>
      <visual name='v'><geometry><box><size>0.15 6 2.4</size></box></geometry>
        <material><ambient>0.85 0.78 0.70 1</ambient><diffuse>0.85 0.78 0.70 1</diffuse></material>
      </visual></link></model>

    <!-- ── Furniture (static obstacles) ─────────────────────────────────── -->

    <!-- Sofa in living room: 4 legs + seat slab + backrest + armrests (fidelity pass) -->
    <model name='sofa'>
      <static>true</static><pose>-5.5 4.5 0 0 0 0</pose>
      <link name='link'>
        <collision name='c_leg_fl'><pose>1.0 0.3 0.075 0 0 0</pose><geometry><box><size>0.1 0.1 0.15</size></box></geometry></collision>
        <visual name='v_leg_fl'><pose>1.0 0.3 0.075 0 0 0</pose><geometry><box><size>0.1 0.1 0.15</size></box></geometry>
          <material><ambient>0.45 0.38 0.55 1</ambient><diffuse>0.45 0.38 0.55 1</diffuse></material></visual>
        <collision name='c_leg_fr'><pose>1.0 -0.3 0.075 0 0 0</pose><geometry><box><size>0.1 0.1 0.15</size></box></geometry></collision>
        <visual name='v_leg_fr'><pose>1.0 -0.3 0.075 0 0 0</pose><geometry><box><size>0.1 0.1 0.15</size></box></geometry>
          <material><ambient>0.45 0.38 0.55 1</ambient><diffuse>0.45 0.38 0.55 1</diffuse></material></visual>
        <collision name='c_leg_bl'><pose>-1.0 0.3 0.075 0 0 0</pose><geometry><box><size>0.1 0.1 0.15</size></box></geometry></collision>
        <visual name='v_leg_bl'><pose>-1.0 0.3 0.075 0 0 0</pose><geometry><box><size>0.1 0.1 0.15</size></box></geometry>
          <material><ambient>0.45 0.38 0.55 1</ambient><diffuse>0.45 0.38 0.55 1</diffuse></material></visual>
        <collision name='c_leg_br'><pose>-1.0 -0.3 0.075 0 0 0</pose><geometry><box><size>0.1 0.1 0.15</size></box></geometry></collision>
        <visual name='v_leg_br'><pose>-1.0 -0.3 0.075 0 0 0</pose><geometry><box><size>0.1 0.1 0.15</size></box></geometry>
          <material><ambient>0.45 0.38 0.55 1</ambient><diffuse>0.45 0.38 0.55 1</diffuse></material></visual>
        <collision name='c_seat'><pose>0 0 0.25 0 0 0</pose><geometry><box><size>2.2 0.8 0.2</size></box></geometry></collision>
        <visual name='v_seat'><pose>0 0 0.25 0 0 0</pose><geometry><box><size>2.2 0.8 0.2</size></box></geometry>
          <material><ambient>0.45 0.38 0.55 1</ambient><diffuse>0.45 0.38 0.55 1</diffuse></material></visual>
        <collision name='c_back'><pose>0 0.3 0.525 0 0 0</pose><geometry><box><size>2.2 0.2 0.35</size></box></geometry></collision>
        <visual name='v_back'><pose>0 0.3 0.525 0 0 0</pose><geometry><box><size>2.2 0.2 0.35</size></box></geometry>
          <material><ambient>0.45 0.38 0.55 1</ambient><diffuse>0.45 0.38 0.55 1</diffuse></material></visual>
        <collision name='c_arm_l'><pose>1.0 0 0.40 0 0 0</pose><geometry><box><size>0.2 0.8 0.3</size></box></geometry></collision>
        <visual name='v_arm_l'><pose>1.0 0 0.40 0 0 0</pose><geometry><box><size>0.2 0.8 0.3</size></box></geometry>
          <material><ambient>0.45 0.38 0.55 1</ambient><diffuse>0.45 0.38 0.55 1</diffuse></material></visual>
        <collision name='c_arm_r'><pose>-1.0 0 0.40 0 0 0</pose><geometry><box><size>0.2 0.8 0.3</size></box></geometry></collision>
        <visual name='v_arm_r'><pose>-1.0 0 0.40 0 0 0</pose><geometry><box><size>0.2 0.8 0.3</size></box></geometry>
          <material><ambient>0.45 0.38 0.55 1</ambient><diffuse>0.45 0.38 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Coffee table: 4 legs + tabletop slab (fidelity pass) -->
    <model name='coffee_table'>
      <static>true</static><pose>-5.5 3.2 0 0 0 0</pose>
      <link name='link'>
        <collision name='c_leg_fl'><pose>0.42 0.22 0.20 0 0 0</pose><geometry><box><size>0.06 0.06 0.40</size></box></geometry></collision>
        <visual name='v_leg_fl'><pose>0.42 0.22 0.20 0 0 0</pose><geometry><box><size>0.06 0.06 0.40</size></box></geometry>
          <material><ambient>0.55 0.40 0.28 1</ambient><diffuse>0.55 0.40 0.28 1</diffuse></material></visual>
        <collision name='c_leg_fr'><pose>0.42 -0.22 0.20 0 0 0</pose><geometry><box><size>0.06 0.06 0.40</size></box></geometry></collision>
        <visual name='v_leg_fr'><pose>0.42 -0.22 0.20 0 0 0</pose><geometry><box><size>0.06 0.06 0.40</size></box></geometry>
          <material><ambient>0.55 0.40 0.28 1</ambient><diffuse>0.55 0.40 0.28 1</diffuse></material></visual>
        <collision name='c_leg_bl'><pose>-0.42 0.22 0.20 0 0 0</pose><geometry><box><size>0.06 0.06 0.40</size></box></geometry></collision>
        <visual name='v_leg_bl'><pose>-0.42 0.22 0.20 0 0 0</pose><geometry><box><size>0.06 0.06 0.40</size></box></geometry>
          <material><ambient>0.55 0.40 0.28 1</ambient><diffuse>0.55 0.40 0.28 1</diffuse></material></visual>
        <collision name='c_leg_br'><pose>-0.42 -0.22 0.20 0 0 0</pose><geometry><box><size>0.06 0.06 0.40</size></box></geometry></collision>
