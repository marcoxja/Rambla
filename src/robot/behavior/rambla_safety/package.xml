<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rambla_safety</name>
  <version>0.0.1</version>
  <description>Local safety-reflex layer and sole final cmd_vel publisher: arbitrates AUTO/MANUAL command authority and halts/overrides cmd_vel on imminent collision using LiDAR and bumper contact, independent of any map or server.</description>
  <maintainer email="jackdemarco.jd@gmail.com">Jack Demarco</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
